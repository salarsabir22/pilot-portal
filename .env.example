# Change these before the portal is public.
PILOT_SECRET=replace-with-a-long-random-string
PILOT_ADMIN_PASSWORD=replace-with-a-founder-password

# Same Supabase project as the dashboard. Service role stays on the server.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Leave both false. The portal does not display verification codes.
PILOT_DEMO=false
PILOT_DEMO_OTP=false

# Email via Resend. The from-address must be a verified sender.
# The verification code and the temporary password are sent only by email.
RESEND_API_KEY=
PILOT_EMAIL_FROM=swypejobs <pilot@swypejobs.app>
